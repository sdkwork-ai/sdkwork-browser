{
  "name": "@sdkwork/browser-pc-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PC browser runtime bootstrap, SDK clients, and IAM wiring.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bootstrap/*": "./src/bootstrap/*",
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "import": "./src/sdk/index.ts",
      "default": "./src/sdk/index.ts"
    },
    "./modules": {
      "types": "./src/modules/index.ts",
      "import": "./src/modules/index.ts",
      "default": "./src/modules/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "import": "./src/session/index.ts",
      "default": "./src/session/index.ts"
    },
    "./composition": {
      "types": "./src/composition/index.ts",
      "import": "./src/composition/index.ts",
      "default": "./src/composition/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sdkwork/browser-app-sdk": "workspace:*",
    "@sdkwork/browser-backend-sdk": "workspace:*",
    "@sdkwork/sdk-common": "workspace:*"
  },
  "sdkwork": {
    "workspace": "sdkwork-browser",
    "architecture": "pc",
    "role": "core",
    "domain": "platform",
    "capability": "browser"
  }
}
