# cloud.development
SDKWORK_BROWSER_DEPLOYMENT_PROFILE=cloud
SDKWORK_BROWSER_ENVIRONMENT=development
SDKWORK_BROWSER_PROFILE_ID=cloud.development
SDKWORK_BROWSER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_BROWSER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BROWSER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_BROWSER_WEB_DEV_INGRESS_BIND=127.0.0.1:5656
SDKWORK_BROWSER_PC_INTERNAL_DEV_PORT=5658
SDKWORK_BROWSER_H5_INTERNAL_DEV_PORT=5659


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5656,http://localhost:5656,https://browser-dev.sdkwork.com,http://browser-dev.sdkwork.com,https://browser-dev.birdcoder.com,http://browser-dev.birdcoder.com,https://browser-dev.dtupay.com,http://browser-dev.dtupay.com,https://browser-dev.noaper.com,http://browser-dev.noaper.com,https://browser-dev.sdkwork.cn,http://browser-dev.sdkwork.cn,https://browser-dev.birdcoder.cn,http://browser-dev.birdcoder.cn,https://browser-dev.dtupay.cn,http://browser-dev.dtupay.cn,https://browser-dev.noaper.cn,http://browser-dev.noaper.cn,https://browser-dev.skubc.com,http://browser-dev.skubc.com,https://browser-dev.skubc.cn,http://browser-dev.skubc.cn,https://browser-dev.zowalk.com,http://browser-dev.zowalk.com,https://browser-dev.zowalk.cn,http://browser-dev.zowalk.cn,https://browser-dev.offer86.com,http://browser-dev.offer86.com,https://browser-dev.offer86.cn,http://browser-dev.offer86.cn,https://browser-dev.86offer.com,http://browser-dev.86offer.com,https://browser-dev.86offer.cn,http://browser-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
