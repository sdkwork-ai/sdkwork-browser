# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_BROWSER_DEPLOYMENT_PROFILE=cloud
SDKWORK_BROWSER_ENVIRONMENT=staging
SDKWORK_BROWSER_PROFILE_ID=cloud.staging
SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=https://browser-staging.sdkwork.com
SDKWORK_BROWSER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BROWSER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

