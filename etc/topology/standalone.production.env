# standalone.production
SDKWORK_BROWSER_DEPLOYMENT_PROFILE=standalone
SDKWORK_BROWSER_ENVIRONMENT=production
SDKWORK_BROWSER_PROFILE_ID=standalone.production

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BROWSER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_BROWSER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
VITE_SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
SDKWORK_BROWSER_PC_STATIC_ROOT=/usr/share/sdkwork/browser/web/pc
SDKWORK_CORS_ALLOWED_ORIGINS=https://browser.sdkwork.com,https://browser.birdcoder.com,https://browser.dtupay.com,https://browser.noaper.com,https://browser.sdkwork.cn,https://browser.birdcoder.cn,https://browser.dtupay.cn,https://browser.noaper.cn,https://browser.skubc.com,https://browser.skubc.cn,https://browser.zowalk.com,https://browser.zowalk.cn,https://browser.offer86.com,https://browser.offer86.cn,https://browser.86offer.com,https://browser.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
