# cloud.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_browser_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_browser_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_BROWSER_DEPLOYMENT_PROFILE=cloud
SDKWORK_BROWSER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_BROWSER_PROFILE_ID=cloud.demo
SDKWORK_BROWSER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_BROWSER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BROWSER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_BROWSER_WEB_DEV_INGRESS_BIND=127.0.0.1:5656
SDKWORK_BROWSER_PC_INTERNAL_DEV_PORT=5658
SDKWORK_BROWSER_H5_INTERNAL_DEV_PORT=5659


SDKWORK_CORS_ALLOWED_ORIGINS=https://browser-demo.sdkwork.com,http://browser-demo.sdkwork.com,https://browser-demo.birdcoder.com,http://browser-demo.birdcoder.com,https://browser-demo.dtupay.com,http://browser-demo.dtupay.com,https://browser-demo.noaper.com,http://browser-demo.noaper.com,https://browser-demo.sdkwork.cn,http://browser-demo.sdkwork.cn,https://browser-demo.birdcoder.cn,http://browser-demo.birdcoder.cn,https://browser-demo.dtupay.cn,http://browser-demo.dtupay.cn,https://browser-demo.noaper.cn,http://browser-demo.noaper.cn,https://browser-demo.skubc.com,http://browser-demo.skubc.com,https://browser-demo.skubc.cn,http://browser-demo.skubc.cn,https://browser-demo.zowalk.com,http://browser-demo.zowalk.com,https://browser-demo.zowalk.cn,http://browser-demo.zowalk.cn,https://browser-demo.offer86.com,http://browser-demo.offer86.com,https://browser-demo.offer86.cn,http://browser-demo.offer86.cn,https://browser-demo.86offer.com,http://browser-demo.86offer.com,https://browser-demo.86offer.cn,http://browser-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
