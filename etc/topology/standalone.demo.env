# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_browser_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_browser_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_BROWSER_DEPLOYMENT_PROFILE=standalone
SDKWORK_BROWSER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_BROWSER_PROFILE_ID=standalone.demo
SDKWORK_BROWSER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
VITE_SDKWORK_BROWSER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_BROWSER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_BROWSER_WEB_DEV_INGRESS_BIND=127.0.0.1:5656
SDKWORK_BROWSER_PC_INTERNAL_DEV_PORT=5658
SDKWORK_BROWSER_H5_INTERNAL_DEV_PORT=5659


